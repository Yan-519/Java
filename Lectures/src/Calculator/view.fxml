<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>

<GridPane xmlns="http://javafx.com/javafx/17" 
          xmlns:fx="http://javafx.com/fxml/1" 
          fx:controller="Calculator.Main"
          hgap="10" vgap="10" 
          alignment="CENTER">
    
    <!-- FIX: Standard FXML syntax for Insets -->
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Display Screen -->
    <TextField fx:id="mainEntry" 
               editable="false" 
               alignment="CENTER_RIGHT" 
               style="-fx-font-size: 18px;" 
               GridPane.columnIndex="0" 
               GridPane.rowIndex="0" 
               GridPane.columnSpan="4" />

    <!-- Row 1 -->
    <Button text="C" prefWidth="50" prefHeight="50" GridPane.columnIndex="0" GridPane.rowIndex="1" onAction="#clearPress"/>
    <Button text="/" prefWidth="50" prefHeight="50" GridPane.columnIndex="3" GridPane.rowIndex="1" onAction="#operationPress"/>

    <!-- Row 2 -->
    <Button text="7" prefWidth="50" prefHeight="50" GridPane.columnIndex="0" GridPane.rowIndex="2" onAction="#numberPress" />
    <Button text="8" prefWidth="50" prefHeight="50" GridPane.columnIndex="1" GridPane.rowIndex="2" onAction="#numberPress"  />
    <Button text="9" prefWidth="50" prefHeight="50" GridPane.columnIndex="2" GridPane.rowIndex="2" onAction="#numberPress"  />
    <Button text="*" prefWidth="50" prefHeight="50" GridPane.columnIndex="3" GridPane.rowIndex="2"  onAction="#operationPress"/>

    <!-- Row 3 -->
    <Button text="4" prefWidth="50" prefHeight="50" GridPane.columnIndex="0" GridPane.rowIndex="3" onAction="#numberPress"  />
    <Button text="5" prefWidth="50" prefHeight="50" GridPane.columnIndex="1" GridPane.rowIndex="3" onAction="#numberPress"  />
    <Button text="6" prefWidth="50" prefHeight="50" GridPane.columnIndex="2" GridPane.rowIndex="3" onAction="#numberPress"  />
    <Button text="-" prefWidth="50" prefHeight="50" GridPane.columnIndex="3" GridPane.rowIndex="3"  onAction="#operationPress"/>

    <!-- Row 4 -->
    <Button text="1" prefWidth="50" prefHeight="50" GridPane.columnIndex="0" GridPane.rowIndex="4" onAction="#numberPress"  />
    <Button text="2" prefWidth="50" prefHeight="50" GridPane.columnIndex="1" GridPane.rowIndex="4" onAction="#numberPress"  />
    <Button text="3" prefWidth="50" prefHeight="50" GridPane.columnIndex="2" GridPane.rowIndex="4" onAction="#numberPress"  />
    <Button text="+" prefWidth="50" prefHeight="50" GridPane.columnIndex="3" GridPane.rowIndex="4"  onAction="#operationPress"/>

    <!-- Row 5 -->
    <Button text="0" prefWidth="110" prefHeight="50" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2" onAction="#numberPress"  />
    <Button text="=" prefWidth="50" prefHeight="50" GridPane.columnIndex="3" GridPane.rowIndex="5" onAction="#equalsPress"/>

</GridPane>